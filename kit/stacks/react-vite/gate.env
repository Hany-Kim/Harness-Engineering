# react-vite 스택 게이트 명령 — harness/gates/gate.sh가 순서대로 실행한다.
# 빈 값("")은 건너뛴다. 프로젝트 스크립트 이름이 다르면 여기만 고치면 된다.
GATE_FORMAT_CMD="npx prettier --check ."
GATE_FORMAT_FILE_CMD="npx prettier --write"
GATE_FORMAT_EXTENSIONS="ts tsx js jsx css scss json"
GATE_LINT_CMD="npx eslint src --max-warnings=0"
GATE_TYPECHECK_CMD="npx tsc --noEmit"
# 레이어링은 eslint-plugin-boundaries가 lint 단계에서 강제한다 (docs/architecture/stack.md)
GATE_ARCH_CMD=""
GATE_TEST_CMD="npx vitest run"
GATE_BUILD_CMD="npm run build"
GATE_DEFAULT_BRANCH="{{DEFAULT_BRANCH}}"
GATE_PROTECTED_BRANCHES="main master develop"
