# fastapi 스택 게이트 명령 — harness/gates/gate.sh가 순서대로 실행한다.
# 빈 값("")은 건너뛴다. 프로젝트 도구 구성이 다르면 여기만 고치면 된다.
GATE_FORMAT_CMD="ruff format --check ."
GATE_FORMAT_FILE_CMD="ruff format"
GATE_FORMAT_EXTENSIONS="py"
GATE_LINT_CMD="ruff check ."
GATE_TYPECHECK_CMD="mypy app"
# 레이어링은 import-linter 계약이 강제한다 (docs/architecture/stack.md)
GATE_ARCH_CMD="lint-imports"
GATE_TEST_CMD="pytest -q"
GATE_BUILD_CMD=""
GATE_DEFAULT_BRANCH="{{DEFAULT_BRANCH}}"
GATE_PROTECTED_BRANCHES="main master develop"
# FastAPI 레이아웃의 소스 루트는 app/ — 계획 선행 검사와 편집 가드가 이 패턴을 쓴다
GATE_SRC_PATTERN="^(app|src)/"
