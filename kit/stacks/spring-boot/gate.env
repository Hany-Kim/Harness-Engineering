# spring-boot 스택 게이트 명령 — harness/gates/gate.sh가 순서대로 실행한다.
# 빈 값("")은 건너뛴다. Gradle 태스크 이름이 다르면 여기만 고치면 된다.
GATE_FORMAT_CMD="./gradlew spotlessCheck"
GATE_FORMAT_FILE_CMD=""
GATE_FORMAT_EXTENSIONS=""
# checkstyle을 쓰면: "./gradlew checkstyleMain checkstyleTest"
GATE_LINT_CMD=""
# 타입 검사는 컴파일이 담당 — test/build에 포함된다
GATE_TYPECHECK_CMD=""
# 레이어링·Optional 반환 규칙은 ArchUnit이 test 단계에서 강제한다 (docs/architecture/stack.md)
GATE_ARCH_CMD=""
GATE_TEST_CMD="./gradlew test"
GATE_BUILD_CMD="./gradlew build -x test"
GATE_DEFAULT_BRANCH="{{DEFAULT_BRANCH}}"
GATE_PROTECTED_BRANCHES="main master develop"
